--- !u!114 &1222508360
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1222508359}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 185db21c8f7e09a4a9ddb543ce354ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSource: {fileID: 1222508363}
  mainCharacterStartDialogue:
  - line: The Core... back where it all began!
    audioClip: {fileID: 8300000, guid: d1b635f9eb2e36f43adb73dea11d2f77, type: 3}
  - line: 'If there is any hope of finding Elenor starting here makes the most sense. '
    audioClip: {fileID: 8300000, guid: 27ca1dc05b8d5564ba33bee64039d8e3, type: 3}
  lockedLockerDialogue:
  - line: I need a code...
    audioClip: {fileID: 8300000, guid: 55a1abbc79be5db41a56698416a1d526, type: 3}
  lockedDoor:
  - line: "It\xB4s locked..."
    audioClip: {fileID: 8300000, guid: c1a2336535ec1784ca7544843daed214, type: 3}
  ringSubtitleData:
  - line: 'Look who''s here. I''m glad that you received my message, Jonathan. '
    audioClip: {fileID: 8300000, guid: 5f196bfa32b951d48bff3dc724cd47f6, type: 3}
  - line: 'Do you remember me? The foreman that nobody took seriously? '
    audioClip: {fileID: 8300000, guid: 03e59f4304625f44ca64c052b0b25ab5, type: 3}
  - line: "I\u2019m calling the shots in Hephastoria now! The TEARS are under my
      control."
    audioClip: {fileID: 8300000, guid: d226adade50be8b4aa702cdf107a88b0, type: 3}
  - line: Alfred, you treacherous rat! Do you know what you have done to our city?!
    audioClip: {fileID: 8300000, guid: d7bcbf31c3f49124090c5e4c05626965, type: 3}
  - line: Our people?! Where is Elenor? Tell me!
    audioClip: {fileID: 8300000, guid: b65ddbf310d908741b503e4a247ba2c8, type: 3}
  - line: "Don\u2019t worry about that, I promise she\u2019ll join you soon enough. "
    audioClip: {fileID: 8300000, guid: 0476d4bfd10e48b478bad5d026a671c6, type: 3}
  - line: 'But I think you have some more pressing concerns at the moment. '
    audioClip: {fileID: 8300000, guid: dd75b1e597ae9f649ba6a53e756ec12b, type: 3}
  - line: Now, surrender to my little friends.
    audioClip: {fileID: 8300000, guid: 5a0d779fc09503b4ba6bafd131a901aa, type: 3}
  - line: "Alfred\u2026 you\u2019ll regret this\u2026"
    audioClip: {fileID: 8300000, guid: 86e7913124346a14ab4d3b091419cf2a, type: 3}
  - line: He activated the core and closed the entrance doors. Damn it.
    audioClip: {fileID: 8300000, guid: a29c728471477f2429f998d0bf1b6e49, type: 3}
  - line: "It seems some of the T.E.A.R.S. that were lying around weren\u2019t as
      dead as I thought they were."
    audioClip: {fileID: 8300000, guid: 2e98ddfa5eeb1384f89057f10c0ec3b4, type: 3}
  - line: "I need to deactivate the CORE again\u2026 There should be a key somewhere
      nearby."
    audioClip: {fileID: 8300000, guid: f5193cce088e14442bae1eba028bdcb3, type: 3}
  controlPanelWithoutKey:
  - line: I need a key...
    audioClip: {fileID: 8300000, guid: 59c688cc8ee1e184585b9de9335f9236, type: 3}
  afterDefeatingSecondWave:
  - line: He dropped a memory module.
    audioClip: {fileID: 8300000, guid: 1bbe050c47f8b1347bccdbc8c873c42a, type: 3}
  - line: "Seems like it contains the code for a specific locker. I should try those
      below the office. \r\n"
    audioClip: {fileID: 8300000, guid: eb9b71000e792014ba7debc60f7298c9, type: 3}
  activatingControlPanel:
  - line: 'The CORE is deactivated. I should be able to leave now. '
    audioClip: {fileID: 8300000, guid: 30f4170481b3c9a4aa8c790f54d5c6a7, type: 3}
  dialogueTextComponent: {fileID: 1752295769}
  musicSource: {fileID: 1222508364}
  mainMenuMusic: {fileID: 8300000, guid: f7576dc6aa22ce6448c5635acc734a96, type: 3}
  inBattleMusic: {fileID: 0}
  inGameMusic: {fileID: 8300000, guid: 1eceba9f546c247499285f8ac30d20bc, type: 3}
  gameOverMusic: {fileID: 0}
