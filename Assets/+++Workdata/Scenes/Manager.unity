  m_Script: {fileID: 11500000, guid: 185db21c8f7e09a4a9ddb543ce354ca5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSource: {fileID: 1222508362}
  mainCharacterStartDialogue:
  - line: Finally. I managed to get here.
    audioClip: {fileID: 8300000, guid: a013d75f8bcc70b4d9bd37ca26858dd0, type: 3}
  - line: This is where elenoire was last according to our plans. Maybe i will find
      something here.
    audioClip: {fileID: 8300000, guid: 8f2e74999a596e842bea4e40a5eb2561, type: 3}
  ringSubtitleData:
  - line: fewgewgg
    audioClip: {fileID: 8300000, guid: a013d75f8bcc70b4d9bd37ca26858dd0, type: 3}
  - line: regergeger
    audioClip: {fileID: 8300000, guid: 8f2e74999a596e842bea4e40a5eb2561, type: 3}
  afterDefeatingSecondWave:
  - line: Hmmm... None if them had the key for the control panel.
    audioClip: {fileID: 8300000, guid: a013d75f8bcc70b4d9bd37ca26858dd0, type: 3}
  - line: Maybe it could be inside one of the lockers under the control office?
    audioClip: {fileID: 8300000, guid: 8f2e74999a596e842bea4e40a5eb2561, type: 3}
