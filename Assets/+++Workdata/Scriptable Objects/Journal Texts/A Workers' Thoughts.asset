  m_Script: {fileID: 11500000, guid: 83cd6b8211edbb34e830a40f09d7582f, type: 3}
  m_Name: A Workers' Thoughts
  m_EditorClassIdentifier: 
  journalText: "It's the day before \u201CFrancis-Memorial-Day\u201D, but something
    feels off\u2026\n\r\nI feel like there is some sort of tension rising between
    some of the engineers and supervisors and I don't think it's because of the celebrations
    tomorrow\u2026\n\n\rAlfred also seems more isolated than ever. I saw him fiddling
    around with the Trip-Oil tank system on the back of the T.E.A.R.S. yesterday
    for quite some time but he's probably just inspecting them as usual. \r\n\r\n\rUgh,
    why did I accept this job down here? \r\n"
  textAudio: {fileID: 0}
